{
  "manifest_version": 3,
  "name": "Human Shaped session recorder",
  "short_name": "HS recorder",
  "version": "0.1.0",
  "description": "Records a Google Meet session you host, after you announce it, and saves it to this computer and the cohort's Drive folder.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "identity", "storage", "activeTab"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Record a Human Shaped session",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "oauth2": {
    "client_id": "REPLACE_WITH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.file"]
  }
}
